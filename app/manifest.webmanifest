{
  "name": "Shecurity",
  "short_name": "Shecurity",
  "description": "Free personal safety app. Your own safety circle, SOS alerts with live location, check-ins, fake call and siren.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e5487f",
  "theme_color": "#fbf8fa",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "SOS",
      "short_name": "SOS",
      "description": "Alert your circle after a 5-second countdown",
      "url": "./#sos",
      "icons": [
        {
          "src": "shortcut-sos.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Walk with me",
      "short_name": "Walk",
      "url": "./#walk",
      "icons": [
        {
          "src": "shortcut-walk.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Check-in",
      "short_name": "Check-in",
      "url": "./#timer",
      "icons": [
        {
          "src": "shortcut-timer.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Fake call",
      "short_name": "Fake call",
      "description": "Your phone rings in 5 seconds",
      "url": "./#fakecall-now",
      "icons": [
        {
          "src": "shortcut-call.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}