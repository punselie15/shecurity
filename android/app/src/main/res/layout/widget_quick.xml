<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/wq_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/q0" style="@style/QuickCell" android:background="@drawable/wq_pink" android:textColor="#FFFFFF" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/q1" style="@style/QuickCell" android:background="@drawable/wq_white" android:textColor="#2A2152" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/q2" style="@style/QuickCell" android:background="@drawable/wq_white" android:textColor="#2A2152" android:layout_marginEnd="4dp" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/q3" style="@style/QuickCell" android:background="@drawable/wq_pink" android:textColor="#FFFFFF" android:layout_marginStart="4dp" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
